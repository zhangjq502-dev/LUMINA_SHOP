# React + Vite frontend
VITE_API_URL="http://localhost:4000/api"

# Backend / Prisma tooling
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumina_shop"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=4000

# Local demo only; production always disables demo payments.
PAYMENT_MODE="demo"
# Optional Stripe TEST keys; never use live keys in this learning project.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# SMTP is optional in development; without it mail is saved to backend/.mail-outbox/.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Optional for production same-site subdomains:
# COOKIE_DOMAIN=".example.com"

# Official Alipay SANDBOX only. Change PAYMENT_MODE to alipay after configuring.
ALIPAY_APP_ID=""
ALIPAY_SELLER_ID=""
# Use PEM keys or base64 key content; private key must be PKCS8 (Java format).
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
# Public HTTPS callback, e.g. https://YOUR-TUNNEL/api/payments/alipay/notify
ALIPAY_NOTIFY_URL=""
